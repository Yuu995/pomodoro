{
  "name": "todo-app",
  "version": "1.3.1",
  "description": "一个简洁的桌面待办清单",
  "main": "main.js",
  "scripts": {
    "prestart": "node scripts/build-space-helper.js",
    "start": "electron .",
    "predist": "node scripts/build-space-helper.js",
    "dist": "electron-builder"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.tomato.clock",
    "productName": "ToDo",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "styles.css",
      "tasks.js",
      "markdown.js",
      "confetti.js",
      "popup.html",
      "popup.js",
      "popup.css",
      "assets/**"
    ],
    "extraResources": [
      {
        "from": "helpers/front-window-state",
        "to": "front-window-state"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    }
  }
}
